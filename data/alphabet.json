[{"up":"A","lo":"a","name":"a","sound":"а","word":"auto","pron":"а́уто","ua":"машина","note":""},{"up":"Á","lo":"á","name":"dlouhé á","sound":"а:","word":"máma","pron":"ма́:ма","ua":"мама","note":"Довге а — тягни вдвічі довше."},{"up":"B","lo":"b","name":"bé","sound":"б","word":"byt","pron":"біт","ua":"квартира","note":"У кінці слова звучить як п."},{"up":"C","lo":"c","name":"cé","sound":"ц","word":"cena","pron":"це́на","ua":"ціна","note":"Завжди ц, ніколи не к."},{"up":"Č","lo":"č","name":"čé","sound":"ч","word":"čaj","pron":"чай","ua":"чай","note":""},{"up":"D","lo":"d","name":"dé","sound":"д","word":"dobrý","pron":"до́брі:","ua":"добрий","note":"У кінці слова звучить як т. Di, dě читаються м'яко: дьі, дьє."},{"up":"Ď","lo":"ď","name":"ďé","sound":"дь","word":"ďábel","pron":"дя́:бел","ua":"диявол","note":"Рідко пишеться: перед i, ě м'якість не позначають."},{"up":"E","lo":"e","name":"e","sound":"е","word":"pes","pron":"пес","ua":"пес","note":"Як українське е, не є."},{"up":"É","lo":"é","name":"dlouhé é","sound":"е:","word":"mléko","pron":"мле́:ко","ua":"молоко","note":""},{"up":"Ě","lo":"ě","name":"e s háčkem","sound":"є","word":"město","pron":"мнє́сто","ua":"місто","note":"Сама не буває на початку. bě, pě, vě = бйе, пйе, вйе; mě = мньє; dě, tě, ně = дьє, тьє, ньє."},{"up":"F","lo":"f","name":"ef","sound":"ф","word":"film","pron":"філм","ua":"фільм","note":""},{"up":"G","lo":"g","name":"gé","sound":"ґ","word":"galerie","pron":"ґа́леріе","ua":"галерея","note":"Як українське ґ. Трапляється переважно в запозиченнях."},{"up":"H","lo":"h","name":"há","sound":"г","word":"hora","pron":"го́ра","ua":"гора","note":"Як українське г. У кінці слова — х."},{"up":"CH","lo":"ch","name":"chá","sound":"х","word":"chléb","pron":"хле:п","ua":"хліб","note":"Окрема літера абетки, стоїть після H."},{"up":"I","lo":"i","name":"měkké i","sound":"і","word":"pivo","pron":"пі́во","ua":"пиво","note":"Українське і, не и. Пом'якшує d, t, n перед собою."},{"up":"Í","lo":"í","name":"dlouhé měkké í","sound":"і:","word":"prosím","pron":"про́сі:м","ua":"будь ласка","note":""},{"up":"J","lo":"j","name":"jé","sound":"й","word":"jablko","pron":"я́блко","ua":"яблуко","note":"je, ja, ju = є, я, ю."},{"up":"K","lo":"k","name":"ká","sound":"к","word":"káva","pron":"ка́:ва","ua":"кава","note":""},{"up":"L","lo":"l","name":"el","sound":"л","word":"les","pron":"лес","ua":"ліс","note":""},{"up":"M","lo":"m","name":"em","sound":"м","word":"moře","pron":"мо́рже","ua":"море","note":""},{"up":"N","lo":"n","name":"en","sound":"н","word":"noc","pron":"ноц","ua":"ніч","note":""},{"up":"Ň","lo":"ň","name":"eň","sound":"нь","word":"kůň","pron":"ку:нь","ua":"кінь","note":""},{"up":"O","lo":"o","name":"o","sound":"о","word":"okno","pron":"о́кно","ua":"вікно","note":""},{"up":"Ó","lo":"ó","name":"dlouhé ó","sound":"о:","word":"gól","pron":"ґо:л","ua":"гол","note":"Трапляється переважно в запозиченнях."},{"up":"P","lo":"p","name":"pé","sound":"п","word":"pošta","pron":"по́шта","ua":"пошта","note":""},{"up":"Q","lo":"q","name":"kvé","sound":"кв","word":"aquapark","pron":"а́куапарк","ua":"аквапарк","note":"Лише в іноземних словах."},{"up":"R","lo":"r","name":"er","sound":"р","word":"ryba","pron":"рі́ба","ua":"риба","note":"Може бути голосним: krk, vlk, čtvrtek."},{"up":"Ř","lo":"ř","name":"eř","sound":"рж","word":"řeka","pron":"рже́ка","ua":"річка","note":"Р і ж одночасно. Найважчий звук — якщо не виходить, кажи «рж»."},{"up":"S","lo":"s","name":"es","sound":"с","word":"sůl","pron":"су:л","ua":"сіль","note":""},{"up":"Š","lo":"š","name":"eš","sound":"ш","word":"škola","pron":"шко́ла","ua":"школа","note":""},{"up":"T","lo":"t","name":"té","sound":"т","word":"tráva","pron":"тра́:ва","ua":"трава","note":"ti, tě читаються м'яко: тьі, тьє."},{"up":"Ť","lo":"ť","name":"ťé","sound":"ть","word":"chuť","pron":"хуть","ua":"смак","note":""},{"up":"U","lo":"u","name":"u","sound":"у","word":"ulice","pron":"у́ліце","ua":"вулиця","note":""},{"up":"Ú","lo":"ú","name":"dlouhé ú","sound":"у:","word":"úte